<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tokyo Weather"
        Height="780"
        Width="700"
        MinHeight="700"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#080F1F">

    <Window.Resources>

        <!-- 共通カード -->
        <Style x:Key="WeatherCard" TargetType="Border">
            <Setter Property="Background" Value="#17243B"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- 予報リスト -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="False"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 予報カード -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Background" Value="#17243B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="3,4"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#263B5B"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#304A70"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="30,25,30,15">
            <StackPanel>

                <TextBlock Text="W E A T H E R   D A S H B O A R D"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#7189B0"/>

                <TextBlock Text="東京の天気予報"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,8,0,0"/>

                <TextBlock Text="TOKYO, JAPAN"
                           FontSize="11"
                           Foreground="#8BA4C9"
                           Margin="0,5,0,0"/>

            </StackPanel>
        </Grid>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24,5,24,25">

                <!-- メイン天気カード -->
                <Border CornerRadius="24"
                        Padding="25"
                        Margin="6,5,6,15">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#244C83"
                                          Offset="0"/>
                            <GradientStop Color="#26346F"
                                          Offset="0.55"/>
                            <GradientStop Color="#402C72"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="現在の気温"
                                       FontSize="15"
                                       Foreground="#C5D9F7"/>

                            <TextBlock x:Name="TemperatureText"
                                       Text="--°C"
                                       FontSize="76"
                                       FontWeight="Light"
                                       Foreground="White"
                                       Margin="0,5,0,0"/>

                            <TextBlock x:Name="WeatherText"
                                       Text="天気を読み込み中..."
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#E0EBFF"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="東京の現在の天気"
                                       FontSize="12"
                                       Foreground="#B3C9EA"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="☀"
                                   FontSize="90"
                                   Foreground="#FFD77A"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0"/>

                    </Grid>
                </Border>

                <!-- 詳細情報 -->
                <Grid Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 湿度 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource WeatherCard}">

                        <StackPanel>

                            <TextBlock Text="HUMIDITY"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8198BD"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">

                                <TextBlock Text="💧"
                                           FontSize="25"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="HumidityText"
                                           Text="-- %"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 風速 -->
                    <Border Grid.Column="1"
                            Style="{StaticResource WeatherCard}">

                        <StackPanel>

                            <TextBlock Text="WIND SPEED"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8198BD"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">

                                <TextBlock Text="🌬"
                                           FontSize="25"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="WindText"
                                           Text="-- m/s"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- 週間予報 -->
                <Border Background="#111D32"
                        CornerRadius="20"
                        Padding="20"
                        Margin="6,5,6,0">

                    <StackPanel>

                        <Grid Margin="0,0,0,15">

                            <TextBlock Text="7日間の天気予報"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="WEEKLY FORECAST"
                                       FontSize="10"
                                       Foreground="#8198BD"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>

                        </Grid>

                        <Separator Background="#293A56"
                                   Margin="0,0,0,12"/>

                        <!-- 横並び予報 -->
                        <ListBox x:Name="ForecastList"
         Height="145"
         FontSize="15"/>

                    </StackPanel>
                </Border>

                <!-- フッター -->
                <TextBlock Text="WEATHER DASHBOARD  •  TOKYO"
                           FontSize="10"
                           Foreground="#506482"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,5"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
