@model List<MvcBasicSample.Models.Product>;

@{
    ViewData["Title"] = "商品一覧";
    int total = 0;
}

<h1>商品情報</h1>

<ul>
    @foreach (var product in Model) {
        <li>@product.Name @product.Price</li>
        total += product.Price;
    }
    
</ul>
<p>合計:@total 円</p>


